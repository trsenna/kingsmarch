{
	"name": "Kingsmarch Universal",
	"image": "ghcr.io/trsenna/kingsmarch-baseline",
	"features": {
		"ghcr.io/devcontainers/features/php:1": {
			"installComposer": true,
			"version": "8.5"
		},
		"ghcr.io/devcontainers/features/ruby:2": {
			"version": "3.4.9"
		},
		"ghcr.io/devcontainers/features/java:1": {
			"installGradle": "false",
			"installMaven": "false",
			"jdkDistro": "tem",
			"version": "21"
		},
		"ghcr.io/devcontainers/features/go:1": {
			"version": "latest"
		},
		"ghcr.io/tailscale/codespace/tailscale:1": {},
		"ghcr.io/trsenna/kingsmarch-features/bootstrap:0": {},
		"ghcr.io/trsenna/kingsmarch-features/devcontainers-cli:0": {},
		"ghcr.io/trsenna/kingsmarch-features/starship:0": {}
	},
	"overrideFeatureInstallOrder": [
		"ghcr.io/devcontainers/features/php",
		"ghcr.io/devcontainers/features/ruby",
		"ghcr.io/devcontainers/features/java",
		"ghcr.io/devcontainers/features/go",
		"ghcr.io/tailscale/codespace/tailscale",
		"ghcr.io/trsenna/kingsmarch-features/bootstrap",
		"ghcr.io/trsenna/kingsmarch-features/devcontainers-cli",
		"ghcr.io/trsenna/kingsmarch-features/starship"
	]
}
